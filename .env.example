# Copy to .env and fill in. Then run: docker compose up -d --build
# App: http://localhost:3000  (public careers page: /careers)

APP_PORT=3000
PUBLIC_APP_URL=http://localhost:3000

# Database
POSTGRES_USER=hr
POSTGRES_PASSWORD=change-this-db-password
POSTGRES_DB=hr

# Auth – use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=change-this-to-a-long-random-string
# Set to true when served over HTTPS
COOKIE_SECURE=false

# First admin login (Hamza). Demo users ali@paragon.local (HR) and anton@paragon.local (Viewer)
# are created with DEMO_PASSWORD when SEED_DEMO_USERS=true.
ADMIN_EMAIL=hamza@paragon.local
ADMIN_PASSWORD=change-this-admin-password
ADMIN_NAME=Hamza
SEED_DEMO_USERS=true
DEMO_PASSWORD=change-this-demo-password

# Claude (Anthropic) – screening, scorecards, transcript analysis
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5

# Google Workspace sync (Master Recruitment Sheet, candidate folders, calendar)
# 1. Google Cloud console: create a service account, enable Sheets, Drive and Calendar APIs,
#    download its JSON key to ./secrets/google-service-account.json
# 2. Share the Master Recruitment spreadsheet with the service account email (Editor).
# 3. Add the service account as a Content manager of the company Shared Drive and put the
#    ID of the root candidates folder (inside that Shared Drive) below.
# 4. Optional: share a Google Calendar with the service account ("Make changes to events").
GOOGLE_SYNC_ENABLED=false
GOOGLE_SPREADSHEET_ID=
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_CALENDAR_ID=

# Email – leave SMTP_HOST empty to only log emails in the in-app Outbox
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Intake webhook for external forms (header: X-Webhook-Secret). Leave empty to disable.
WEBHOOK_SECRET=
